{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["needs_followup", "complete", "blocked"]
    },
    "summary": { "type": "string" },
    "answer": { "type": "string" },
    "observations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "media_index": { "type": "integer", "minimum": 0 },
              "locator": { "type": "string" }
            },
            "required": ["media_index", "locator"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["claim", "evidence", "confidence"]
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lane": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["covered", "not_applicable", "missing"]
          },
          "note": { "type": "string" }
        },
        "required": ["lane", "status", "note"]
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "material", "minor"]
          },
          "how_to_resolve": { "type": "string" }
        },
        "required": ["claim", "severity", "how_to_resolve"]
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string" }
    },
    "suggested_followups": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "boundary_reason": { "type": "string" }
  },
  "required": [
    "status",
    "summary",
    "answer",
    "observations",
    "coverage",
    "uncertainties",
    "gaps",
    "suggested_followups",
    "boundary_reason"
  ]
}
